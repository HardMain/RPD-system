# Скопируйте этот файл в .env и подставьте свои значения.
# Сам .env в git не попадает (есть в .gitignore).

# === LLM ===
# Если LLM_API_KEY=demo, бэкенд возвращает заглушки и не делает сетевых запросов.

LLM_API_KEY=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- OpenRouter (рекомендуется для старта) ---
# LLM_API_KEY=sk-or-v1-XXXXXXXXXXXX
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# Другие модели OpenRouter: anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-70b-instruct, qwen/qwen-2.5-72b-instruct

# --- OpenAI напрямую ---
# LLM_API_KEY=sk-proj-XXXXXXXXXXXX
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- YandexGPT (OpenAI-совместимый endpoint) ---
# LLM_API_KEY=AQVN...
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_MODEL=gpt://<folder-id>/yandexgpt/latest

# --- Ollama (локально) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b

# === Security ===
SECRET_KEY=change-this-in-production-to-random-string

# === Database (по умолчанию берётся из docker-compose) ===
# DATABASE_URL=postgresql+asyncpg://rpd_user:rpd_secret@db:5432/rpd_db
